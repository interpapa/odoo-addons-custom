<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_excel_update_form" model="ir.ui.view">
        <field name="name">smart.excel.update.form</field>
        <field name="model">smart.excel.update</field>
        <field name="arch" type="xml">
            <form string="Smart Excel Mass Manager">
                <field name="state" invisible="1"/>
                
                <div invisible="state != 'export'">
                    <div class="alert alert-info" role="alert">
                        <strong>Step 1: Choose Action &amp; Download Template</strong><br/>
                        Select whether you want to export selected products for updating, or download a blank template for creating new products.
                    </div>
                    <group>
                        <field name="template_type" widget="radio"/>
                    </group>
                </div>
                
                <div invisible="state != 'import'">
                    <div class="alert alert-warning" role="alert">
                        <strong>Step 2: Upload Excel File to Sync</strong><br/>
                        Upload your modified or new Excel file below.
                    </div>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="import_file" filename="file_name" widget="binary" string="Upload Excel File"/>
                    </group>
                </div>
                
                <div invisible="state != 'done'">
                    <field name="log_message" readonly="1" nolabel="1" widget="text" style="color: #155724; font-family: monospace; min-height: 180px; background-color: #d4edda; padding: 12px; border-radius: 6px; border: 1px solid #c3e6cb;"/>
                </div>
                
                <footer>
                    <button name="action_generate_template" string="Download Excel Template" type="object" class="btn-primary" invisible="state != 'export'"/>
                    <button name="action_import_data" string="Sync to Odoo (Update / Create)" type="object" class="btn-success" invisible="state != 'import'"/>
                    <button special="cancel" string="Close Wizard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_smart_excel_update" model="ir.actions.act_window">
        <field name="name">Smart Mass Update / Create (Excel)</field>
        <field name="res_model">smart.excel.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>