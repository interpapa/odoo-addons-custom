<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_excel_update_form" model="ir.ui.view">
        <field name="name">smart.excel.update.form</field>
        <field name="model">smart.excel.update</field>
        <field name="arch" type="xml">
            <form string="Smart Excel Mass Update">
                <field name="state" invisible="1"/>
                
                <div invisible="state != 'export'">
                    <div class="alert alert-info text-center" role="alert">
                        <strong>Step 1: Download Template</strong><br/>
                        Click below to generate a smart Excel template containing the selected products.<br/>
                        <span class="text-danger"><b>Do not modify or delete the ID column (Column A).</b></span>
                    </div>
                </div>
                
                <div invisible="state != 'import'">
                    <div class="alert alert-warning text-center" role="alert">
                        <strong>Step 2: Upload Modified Data</strong><br/>
                        Download your generated template (if you haven't yet), update the values in Excel, and upload the modified file below.
                    </div>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="excel_file" filename="file_name" widget="binary" string="Your Modified Excel"/>
                    </group>
                </div>
                
                <div invisible="state != 'done'">
                    <field name="log_message" readonly="1" nolabel="1" widget="text" style="color: #333; font-family: monospace; height: 150px; background-color: #f8f9fa; padding: 10px; border-radius: 5px;"/>
                </div>
                
                <footer>
                    <button name="action_generate_template" string="Generate Template" type="object" class="btn-primary" invisible="state != 'export'"/>
                    <button name="action_import_data" string="Update Database" type="object" class="btn-success" invisible="state != 'import'"/>
                    <button special="cancel" string="Close Wizard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_smart_excel_update" model="ir.actions.act_window">
        <field name="name">Smart Mass Update (Excel)</field>
        <field name="res_model">smart.excel.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>