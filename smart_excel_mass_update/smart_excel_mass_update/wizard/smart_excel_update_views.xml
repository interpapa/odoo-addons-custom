<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         FORM VIEW
    ================================================================ -->
    <record id="view_smart_excel_update_form" model="ir.ui.view">
        <field name="name">smart.excel.update.form</field>
        <field name="model">smart.excel.update</field>
        <field name="arch" type="xml">
            <form string="Smart Excel Manager">
                <field name="state" invisible="1"/>
                <field name="main_mode" invisible="1"/>
                <field name="exported_file" invisible="1"/>

                <!-- ===== DRAFT STATE ===== -->
                <div invisible="state != 'draft'">

                    <!-- EXPORT MODE -->
                    <div invisible="main_mode != 'export'">
                        <div class="alert alert-info" role="alert">
                            <strong>&#128228; Export Products to Excel</strong><br/>
                            The selected products will be exported to an Excel file with their Odoo IDs.
                            Edit the file and re-import it to apply changes in bulk.
                        </div>
                        <group>
                            <field name="product_ids" widget="many2many_tags" readonly="1"
                                   string="Products to Export"/>
                        </group>
                    </div>

                    <!-- IMPORT MODE -->
                    <div invisible="main_mode != 'import'">
                        <div class="alert alert-success" role="alert">
                            <strong>&#128229; Import / Sync Excel File to Odoo</strong><br/>
                            Upload the Excel file you previously exported and edited.
                            Rows with an ID in column A will update existing products.
                            Rows with a blank ID will create new products.
                        </div>
                        <group>
                            <field name="file_name" invisible="1"/>
                            <field name="import_file" filename="file_name"
                                   widget="binary" string="Select Excel File (.xlsx)"/>
                        </group>
                    </div>
                </div>

                <!-- ===== RESULT STATE ===== -->
                <div invisible="state != 'done'">
                    <div class="alert alert-success" role="alert">
                        <strong>&#10003; Operation Complete!</strong>
                        See the summary below.
                    </div>
                    <field name="log_message" readonly="1" nolabel="1" widget="text"
                           style="color:#155724;font-family:monospace;min-height:180px;
                                  background:#d4edda;padding:12px;border-radius:6px;
                                  border:1px solid #c3e6cb;"/>
                </div>

                <footer>
                    <!-- Export action -->
                    <button name="action_generate_template"
                            string="&#128228; Generate Excel File"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or main_mode != 'export'"/>
                    <!-- Import action -->
                    <button name="action_import_data"
                            string="&#128229; Import / Sync to Odoo"
                            type="object" class="btn-success"
                            invisible="state != 'draft' or main_mode != 'import'"/>
                    <!-- Download after export -->
                    <button name="action_download_file"
                            string="&#11015; Download Excel File"
                            type="object" class="btn-primary"
                            invisible="state != 'done' or not exported_file"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================================
         ACTION 1: EXPORT  (contextual on product list — needs selection)
    ================================================================ -->
    <record id="action_smart_excel_export" model="ir.actions.act_window">
        <field name="name">&#128228; Smart Excel: Export Products</field>
        <field name="res_model">smart.excel.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_main_mode': 'export'}</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- ================================================================
         ACTION 2: IMPORT  (standalone — no product selection needed)
    ================================================================ -->
    <record id="action_smart_excel_import" model="ir.actions.act_window">
        <field name="name">&#128229; Smart Excel: Import / Sync File</field>
        <field name="res_model">smart.excel.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_main_mode': 'import'}</field>
    </record>

    <!-- ================================================================
         MENU  (Inventory > Operations > Smart Excel Import)
    ================================================================ -->
    <menuitem id="menu_smart_excel_import"
              name="Smart Excel: Import / Sync"
              action="action_smart_excel_import"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="99"/>

</odoo>