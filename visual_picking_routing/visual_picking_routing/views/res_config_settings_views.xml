<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_visual_picking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.visual.picking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Visual Picking Routing" name="visual_picking_settings">
                    <setting help="Show product images on the picking operations PDF report">
                        <field name="visual_picking_enable_images"/>
                    </setting>
                    <setting help="Select the size of the product images on the PDF" invisible="not visual_picking_enable_images">
                        <field name="visual_picking_image_size" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>