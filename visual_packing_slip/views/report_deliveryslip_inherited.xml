<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_deliveryslip_custom_inherit" inherit_id="stock.report_delivery_document">
        
        <!-- Add Image column header before the Product column in the main delivery table -->
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_product']" position="before">
            <th name="th_sm_image" class="text-center"><strong>Image</strong></th>
        </xpath>

        <!-- Add Image column content before the Product content in the main delivery table -->
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]" position="before">
            <td class="text-center">
                <span t-if="move.product_id.image_128" t-field="move.product_id.image_128" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'style': 'max-height: 80px; max-width: 80px;'}"/>
            </td>
        </xpath>

        <!-- Add Image column header before the Product column in the aggregated delivery table (Has Serial/Lot) -->
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_product']" position="before">
            <th name="th_sml_image" class="text-center"><strong>Image</strong></th>
        </xpath>

        <!-- Add Image column content before the Product content in the aggregated delivery table -->
        <xpath expr="//table[@name='stock_move_line_table']/tbody/tr/td[1]" position="before">
            <td class="text-center">
                <span t-if="move_line.product_id.image_128" t-field="move_line.product_id.image_128" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'style': 'max-height: 80px; max-width: 80px;'}"/>
            </td>
        </xpath>

    </template>
</odoo>