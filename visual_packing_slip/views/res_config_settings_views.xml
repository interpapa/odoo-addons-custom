<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_visual_packing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.visual.packing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Visual Packing Slip" name="visual_packing_settings">
                    <setting help="Show product images on the delivery slip PDF report">
                        <field name="visual_packing_enable_images"/>
                    </setting>
                    <setting help="Select the size of the product images on the delivery PDF" attrs="{'invisible': [('visual_packing_enable_images', '=', False)]}">
                        <field name="visual_packing_image_size" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>